  },
  "dependencies": {
    "@lumi/config": "workspace:*",
    "@lumi/db": "workspace:*",
    "better-auth": "1.6.23",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }

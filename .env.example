# Lumi environment contract
# Copy to .env for local server processes. Values marked "required" have no default.
# Secret placeholders are names only; never put real credentials in this file.

# Local PostgreSQL role passwords (required by Compose; use distinct values)
MIGRATOR_DB_PASSWORD=your-migrator-db-password
AUTH_DB_PASSWORD=your-auth-db-password
API_DB_PASSWORD=your-api-db-password
WORKER_DB_PASSWORD=your-worker-db-password
MIGRATION_DATABASE_URL=postgresql://lumi_migrator:your-migrator-db-password@127.0.0.1:5432/lumi
DATABASE_URL=postgresql://lumi_api:your-api-db-password@127.0.0.1:5432/lumi
WORKER_DATABASE_URL=postgresql://lumi_worker:your-worker-db-password@127.0.0.1:5432/lumi
AUTH_DATABASE_URL=postgresql://lumi_auth:your-auth-db-password@127.0.0.1:5432/lumi
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-random-secret-with-at-least-32-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local development only. Production startup rejects false.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Web server-only API origin (Compose overrides this with http://api:3001)
INTERNAL_API_BASE_URL=http://127.0.0.1:3001
# Realtime polling fallback is the typed V1 config default: 5000 ms.

# Application service clients
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=your-litellm-api-key
LITELLM_MODEL=gpt-5.5
SEARXNG_BASE_URL=http://127.0.0.1:8080
CRAWL4AI_BASE_URL=http://127.0.0.1:11235
TEI_BASE_URL=http://127.0.0.1:8081
TEI_MODEL_ID=BAAI/bge-small-en-v1.5
TEI_EMBEDDING_DIMENSION=384

# LiteLLM provider routing (consumed by the future Docker service config)
LITELLM_DB_USER=lumi_litellm
LITELLM_DB_PASSWORD=your-litellm-db-password
CODEX_API_BASE_URL=http://127.0.0.1:18080
CODEX_API_MODEL=gpt-5.5
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=api-key

# Worker queue — conservative V1 defaults
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_STALE_LOCK_MS=300000
WORKER_CONCURRENCY=5
WORKER_MAX_LESSON_JOBS_PER_COURSE=3

# Hard course-generation budgets — conservative, configurable V1 defaults
GENERATION_MAX_LLM_CALLS=80
GENERATION_MAX_LLM_COST_USD=10
GENERATION_MAX_RESEARCH_ITERATIONS=3
GENERATION_MAX_SEARCH_QUERIES=20
GENERATION_MAX_CRAWLED_SOURCES=40
GENERATION_MAX_CRAWLED_BYTES=50000000
GENERATION_MAX_CONCEPTS=60
GENERATION_MAX_LESSONS=20
GENERATION_MAX_ACTIVE_COURSES_PER_USER=2
COURSE_CREATION_RATE_LIMIT_MAX=3
COURSE_CREATION_RATE_LIMIT_WINDOW_MS=3600000

# MinIO object storage
MINIO_ROOT_USER=lumi_minio_admin
MINIO_ROOT_PASSWORD=your-minio-root-password
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=lumi-assets
MINIO_ACCESS_KEY=lumi_worker_key
MINIO_SECRET_KEY=your-minio-worker-secret
MINIO_READER_ACCESS_KEY=lumi_reader_key
MINIO_READER_SECRET_KEY=your-minio-reader-secret
MINIO_ASSET_MAX_BYTES=5242880

# Research security — conservative, configurable V1 defaults
RESEARCH_MAX_RESOURCE_BYTES=5000000
RESEARCH_MAX_REDIRECTS=3
RESEARCH_ALLOWED_OUTBOUND_PORTS=80,443
RESEARCH_ALLOWED_MIME_TYPES=text/html,text/plain,text/markdown,application/pdf,application/xhtml+xml
RESEARCH_REQUEST_TIMEOUT_MS=20000
RESEARCH_MAX_CRAWL_DEPTH=2
RESEARCH_MAX_PAGES_PER_CRAWL=20
RESEARCH_MAX_DISCOVERED_RESOURCES=100
